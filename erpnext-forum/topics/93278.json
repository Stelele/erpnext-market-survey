      "id": 334341,
      "username": "Smit_Vora",
      "name": "Smit Vora",
      "created_at": "2022-08-13T08:51:48.903Z",
      "cooked": "<p>Item tax templates are required to be created for each company.<br>\nMake sure you have created it for Turqosoft.</p>",
