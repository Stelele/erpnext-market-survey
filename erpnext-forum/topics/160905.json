    {
      "id": 494628,
      "username": "tcbinfotech",
      "name": "TCB Infotech",
      "created_at": "2026-02-19T03:36:30.446Z",
      "cooked": "<p>When assigning a task, the “Assign To” field requires a User account, not just an Employee record.</p>\n<p>Go to Settings &gt; Users, create a user account for each employee, then link that user in the Employee record under the “User ID” field. After that, they will appear in the task assignment list.</p>",
      "avatar_template": "/user_avatar/discuss.frappe.io/tcbinfotech/{size}/93928_2.png",
