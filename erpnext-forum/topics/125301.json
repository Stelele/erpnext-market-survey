    {
      "id": 414098,
      "username": "NCP",
      "name": "Nihantra Patel",
      "created_at": "2024-06-07T11:36:23.206Z",
      "cooked": "<p>It can’t be set directly. If you want an easy way to set it for the view, create a custom button on the list view. Then, set the default report when you click the button.</p>",
      "avatar_template": "/user_avatar/discuss.frappe.io/ncp/{size}/66573_2.png",
      "trust_level": 2,
      "post_number": 6,
      "post_type": 1,
      "like_count": null,
      "like_action": null,
      "Reads": 54,
      "wikis": null,
      "can_edit": false,
