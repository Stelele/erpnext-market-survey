    {
      "id": 487871,
      "username": "Hemil_Sangani",
      "name": "Hemil Sangani",
      "created_at": "2025-12-01T10:28:28.924Z",
      "cooked": "<p>Set Prefix to <strong>HR-DSR-.YYYY.-</strong> and set digits to 4</p>",
      "avatar_template": "/letter_avatar_proxy/v4/letter/h/ce7236/{size}.png",
      "trust_level": 2,
      "post_number": 9,
      "post_type": 1,
      "like_count": null,
