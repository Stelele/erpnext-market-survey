      "id": 479789,
      "username": "Abdeali",
      "name": "Abdeali Chharchhodawala",
      "created_at": "2025-09-03T07:07:52.020Z",
      "cooked": "<p>Just for reference:</p>\n<aside class=\"onebox githubblob\" data-onebox-src=\"https://github.com/frappe/frappe/blob/4b998353562d3769be305555cb29ced4e796ab4c/frappe/public/js/frappe/ui/filters/filter.js#L14\">\n  <header class=\"source\">\n\n      <a href=\"https://github.com/frappe/frappe/blob/4b998353562d3769be305555cb29ced4e796ab4c/frappe/public/js/frappe/ui/filters/filter.js#L14\" target=\"_blank\" rel=\"noopener nofollow ugc\">github.com/frappe/frappe</a>\n  </header>\n\n  <article class=\"onebox-body\">\n    <h4><a href=\"https://github.com/frappe/frappe/blob/4b998353562d3769be305555cb29ced4e796ab4c/frappe/public/js/frappe/ui/filters/filter.js#L14\" target=\"_blank\" rel=\"noopener nofollow ugc\">frappe/public/js/frappe/ui/filters/filter.js</a></h4>\n\n<div class=\"git-blob-info\">\n  <a href=\"https://github.com/frappe/frappe/blob/4b998353562d3769be305555cb29ced4e796ab4c/frappe/public/js/frappe/ui/filters/filter.js#L14\" rel=\"noopener nofollow ugc\"><code>4b9983535</code></a>\n</div>\n\n\n\n    <pre class=\"onebox\"><code class=\"lang-js\">\n      <ol class=\"start lines\" start=\"4\" style=\"counter-reset: li-counter 3 ;\">\n          <li>\t\tif (this.value === null || this.value === undefined) {</li>\n          <li>\t\t\tthis.value = \"\";</li>\n          <li>\t\t}</li>\n          <li></li>\n          <li>\t\tthis.utils = frappe.ui.filter_utils;</li>\n          <li>\t\tthis.set_conditions();</li>\n          <li>\t\tthis.set_conditions_from_config();</li>\n          <li>\t\tthis.make();</li>\n          <li>\t}</li>\n          <li></li>\n          <li class=\"selected\">\tset_conditions() {</li>\n          <li>\t\tthis.conditions = [</li>\n          <li>\t\t\t[\"=\", __(\"Equals\")],</li>\n          <li>\t\t\t[\"!=\", __(\"Not Equals\")],</li>\n          <li>\t\t\t[\"like\", __(\"Like\")],</li>\n          <li>\t\t\t[\"not like\", __(\"Not Like\")],</li>\n          <li>\t\t\t[\"in\", __(\"In\")],</li>\n          <li>\t\t\t[\"not in\", __(\"Not In\")],</li>\n          <li>\t\t\t[\"is\", __(\"Is\")],</li>\n          <li>\t\t\t[\"&gt;\", __(\"Greater Than\")],</li>\n          <li>\t\t\t[\"&lt;\", __(\"Less Than\")],</li>\n      </ol>\n    </code></pre>\n\n\n\n  </article>\n\n  <div class=\"onebox-metadata\">\n    \n    \n  </div>\n\n  <div style=\"clear: both\"></div>\n</aside>\n",
