      "id": 476946,
      "username": "nikkothari22",
      "name": "Nikhil Kothari",
      "created_at": "2025-08-10T16:04:06.952Z",
      "cooked": "<p>In your “Customer” and “Website User” roles - disable desk access. Go to “Role” list and uncheck desk access, then update the user’s roles again. It should not turn to System User.</p>",
      "avatar_template": "/user_avatar/discuss.frappe.io/nikkothari22/{size}/71132_2.png",
