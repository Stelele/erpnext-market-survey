    {
      "id": 406189,
      "username": "gopikrishnan",
      "name": "GOPIKRISHNAN",
      "created_at": "2024-04-29T10:52:41.820Z",
      "cooked": "<p>Changing the valuation method directly in the database is not recommended as it could potentially cause issues with stock transactions. However, if you still need to proceed with it, here is an example query.</p>\n<pre><code class=\"lang-auto\">UPDATE `tabSingles` SET value='FIFO' WHERE `doctype`='Stock Settings' AND `field`='valuation_method';\n</code></pre>\n<p>Please keep in mind the risks involved, and the choice is ultimately yours.</p>",
      "avatar_template": "/user_avatar/discuss.frappe.io/gopikrishnan/{size}/65699_2.png",
      "trust_level": 2,
      "post_number": 2,
      "post_type": 1,
