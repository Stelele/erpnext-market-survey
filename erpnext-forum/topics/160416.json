    {
      "id": 493881,
      "username": "Lakshit_Jain",
      "name": "Lakshit Jain",
      "created_at": "2026-02-10T09:23:39.296Z",
      "cooked": "<p>It is already supported.<br>\nAddress with country as India and gst category as Overseas is allowed.</p>\n<ul>\n<li>Create a supplier address with an Indian address and gst category as Overseas.</li>\n<li>Use that address in the Purchase Invoice</li>\n<li>After submission, you will get the option to create a Bill of Entry.</li>\n</ul>",
      "avatar_template": "/user_avatar/discuss.frappe.io/lakshit_jain/{size}/54645_2.png",
      "trust_level": 2,
