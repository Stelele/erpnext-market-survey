      "created_at": "2025-09-18T19:03:23.173Z",
      "cooked": "<p>In Frappe Education, I would like to add instructors as Frappe users. How can I implement this?</p>",
      "avatar_template": "/user_avatar/discuss.frappe.io/mebratua/{size}/90401_2.png",
      "trust_level": 1,
