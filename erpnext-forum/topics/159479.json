      "created_at": "2026-01-23T13:33:08.758Z",
      "cooked": "<p>Hi <a class=\"mention\" href=\"/u/jennlawlor\">@jennlawlor</a></p>\n<p>Please try this client script.</p>\n<p>frappe.ui.form.on(‘Lead’, {</p>\n<pre><code>refresh: function(frm) {\n\n    // Add button in the activity section\n\n    frm.add_custom_button(\\_\\_('Create Task'), function() {\n\n        // Open a new Task form\n\n        frappe.prompt(\\[\n\n            {\n\n                'fieldname': 'project',\n\n                'fieldtype': 'Link',\n\n                'label': 'Project',\n\n                'options': 'Project',\n\n                'reqd': 1\n\n            },\n\n            {\n\n                'fieldname': 'subject',\n\n                'fieldtype': 'Data',\n\n                'label': 'Task Subject',\n\n                'reqd': 1\n\n            }\n\n        \\],\n\n        function(values){\n\n            frappe.new_doc('Task', {\n\n                project: values.project,\n\n                subject: values.subject,\n\n                reference_type: 'Lead',\n\n                reference_name: frm.doc.name\n\n            });\n\n        },\n\n        \\_\\_('Enter Task Details'),\n\n        \\_\\_('Create Task')\n\n        );\n\n    }, \\_\\_('Create')); // Adds under \"Create\" dropdown\n\n}\n</code></pre>\n<p>});</p>",
