      "id": 434293,
      "username": "NCP",
      "name": "Nihantra Patel",
      "created_at": "2024-09-10T09:20:28.393Z",
      "cooked": "<p>I think, you have to use the listview client script and refresh the listview.</p>\n<pre><code class=\"lang-auto\">listview.refresh();\n</code></pre>",
      "avatar_template": "/user_avatar/discuss.frappe.io/ncp/{size}/66573_2.png",
