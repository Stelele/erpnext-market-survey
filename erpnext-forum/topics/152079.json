    {
      "id": 477956,
      "username": "Priytesh",
      "name": "Priytesh",
      "created_at": "2025-08-19T06:04:55.676Z",
      "cooked": "<p><a class=\"mention\" href=\"/u/astha-pandit\">@Astha-pandit</a> Use Purchase Return / Debit Note if the supplier issues a revised invoice — this keeps both supplier ledger and stock valuation correct.<br>\nIf stock rate changes after posting → use Landed Cost Voucher to adjust stock valuation.<br>\nIf it’s only a price correction, not stock impact → a Debit/Credit Note is the clean way.</p>",
      "avatar_template": "/letter_avatar_proxy/v4/letter/p/3ab097/{size}.png",
      "trust_level": 2,
      "post_number": 2,
      "post_type": 1,
      "like_count": null,
