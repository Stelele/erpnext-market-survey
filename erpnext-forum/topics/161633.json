    {
      "id": 496259,
      "username": "tcbinfotech",
      "name": "TCB Infotech",
      "created_at": "2026-03-24T04:47:26.219Z",
      "cooked": "<p>When you change a field value, sometimes the timestamp in the Frappe database does not get updated. Because of this, the message appears. You need to refresh the page first, then enter the values again after that, the issue will not occur.</p>",
      "avatar_template": "/user_avatar/discuss.frappe.io/tcbinfotech/{size}/93928_2.png",
      "trust_level": 2,
      "post_number": 2,
      "post_type": 1,
      "like_count": null,
      "like_action": null,
      "Reads": 11,
      "wikis": null,
      "can_edit": false,
      "can_delete": false,
      "can_recover": false,
      "can_view_edit_history": true,
      "can_wiki": false,
      "version": 1,
      "last_edited_at": null,
