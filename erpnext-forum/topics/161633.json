      "cooked": "<p><div class=\"lightbox-wrapper\"><a class=\"lightbox\" href=\"https://discuss.frappe.io/uploads/default/original/3X/3/7/37bba21955a304d71aec974ca59033a28e17bbb6.png\" data-download-href=\"https://discuss.frappe.io/uploads/default/37bba21955a304d71aec974ca59033a28e17bbb6\" title=\"image\"><img src=\"https://discuss.frappe.io/uploads/default/optimized/3X/3/7/37bba21955a304d71aec974ca59033a28e17bbb6_2_690x347.png\" alt=\"image\" data-base62-sha1=\"7X2gjxWnsIALG6ydoaWycMvs1ng\" width=\"690\" height=\"347\" srcset=\"https://discuss.frappe.io/uploads/default/optimized/3X/3/7/37bba21955a304d71aec974ca59033a28e17bbb6_2_690x347.png, https://discuss.frappe.io/uploads/default/optimized/3X/3/7/37bba21955a304d71aec974ca59033a28e17bbb6_2_1035x520.png 1.5x, https://discuss.frappe.io/uploads/default/optimized/3X/3/7/37bba21955a304d71aec974ca59033a28e17bbb6_2_1380x694.png 2x\" data-dominant-color=\"6E6D6E\"><div class=\"meta\"><svg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"><use href=\"#far-image\"></use></svg><span class=\"filename\">image</span><span class=\"informations\">1730×872 63.4 KB</span><svg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"><use href=\"#discourse-expand\"></use></svg></div></a></div></p>",
