    {
      "id": 316344,
      "username": "Maheshwari_Bhavesh",
      "name": "Bhavesh Maheshwari",
      "created_at": "2022-02-27T06:45:55.720Z",
      "cooked": "<p>Why don’t we manage the balance in the account itself? Instead of managing separately in the wallet.</p>",
      "avatar_template": "/user_avatar/discuss.frappe.io/maheshwari_bhavesh/{size}/55067_2.png",
      "trust_level": 4,
      "post_number": 6,
      "post_type": 1,
