      "cooked": "<p><div class=\"lightbox-wrapper\"><a class=\"lightbox\" href=\"https://discuss.frappe.io/uploads/default/original/3X/2/f/2f945f39368708aab9de8d37850aa9fac23d3e3c.png\" data-download-href=\"https://discuss.frappe.io/uploads/default/2f945f39368708aab9de8d37850aa9fac23d3e3c\" title=\"image\"><img src=\"https://discuss.frappe.io/uploads/default/optimized/3X/2/f/2f945f39368708aab9de8d37850aa9fac23d3e3c_2_690x463.png\" alt=\"image\" data-base62-sha1=\"6MUkfo3VmrZErIGq2cU8dIEKGIs\" width=\"690\" height=\"463\" srcset=\"https://discuss.frappe.io/uploads/default/optimized/3X/2/f/2f945f39368708aab9de8d37850aa9fac23d3e3c_2_690x463.png, https://discuss.frappe.io/uploads/default/optimized/3X/2/f/2f945f39368708aab9de8d37850aa9fac23d3e3c_2_1035x694.png 1.5x, https://discuss.frappe.io/uploads/default/original/3X/2/f/2f945f39368708aab9de8d37850aa9fac23d3e3c.png 2x\" data-dominant-color=\"FCFCFC\"><div class=\"meta\"><svg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"><use href=\"#far-image\"></use></svg><span class=\"filename\">image</span><span class=\"informations\">1303×876 48.5 KB</span><svg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"><use href=\"#discourse-expand\"></use></svg></div></a></div><br>\n<div class=\"lightbox-wrapper\"><a class=\"lightbox\" href=\"https://discuss.frappe.io/uploads/default/original/3X/4/f/4ff652eb421592b69b36a198d1c0fb61d4e3f34c.png\" data-download-href=\"https://discuss.frappe.io/uploads/default/4ff652eb421592b69b36a198d1c0fb61d4e3f34c\" title=\"image\"><img src=\"https://discuss.frappe.io/uploads/default/optimized/3X/4/f/4ff652eb421592b69b36a198d1c0fb61d4e3f34c_2_690x274.png\" alt=\"image\" data-base62-sha1=\"bpnsVXNukizncOIfNr1qZxlmtNW\" width=\"690\" height=\"274\" srcset=\"https://discuss.frappe.io/uploads/default/optimized/3X/4/f/4ff652eb421592b69b36a198d1c0fb61d4e3f34c_2_690x274.png, https://discuss.frappe.io/uploads/default/optimized/3X/4/f/4ff652eb421592b69b36a198d1c0fb61d4e3