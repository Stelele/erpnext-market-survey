    {
      "id": 484949,
      "username": "vishnurajesh8",
      "name": "Vishnurajesh8",
      "created_at": "2025-10-27T06:07:23.225Z",
      "cooked": "<p>Go to <strong>Home → Settings → System Settings</strong>, then scroll down to <strong>“Default App”</strong> under the <em>General</em> section. Set it to <strong><code>frappe</code></strong> or <strong><code>desk</code></strong>, save the settings, and then run the following commands to clear cache and reload:</p>\n<p>bench clear-cache</p>\n<p>bench restart</p>",
      "avatar_template": "/user_avatar/discuss.frappe.io/vishnurajesh8/{size}/85081_2.png",
      "trust_level": 1,
      "post_number": 2,
      "post_type": 1,
