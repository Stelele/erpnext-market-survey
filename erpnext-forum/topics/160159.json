    {
      "id": 493235,
      "username": "Lastie_Jason_Pule",
      "name": "Lastie Jason Pule",
      "created_at": "2026-02-03T15:00:46.071Z",
      "cooked": "<p>Hi <a class=\"mention\" href=\"/u/asieftejani\">@asieftejani</a>. Thank you for your response.</p>\n<p>Using different browsers does work, since each browser has its own local storage and session state.</p>\n<p>However, in our case this isn’t a viable solution because users share the same workstation and browser in practice. We need the system to handle logout/login cleanly within the same browser and always start a new user at their own home page.</p>",
      "avatar_template": "/user_avatar/discuss.frappe.io/lastie_jason_pule/{size}/63803_2.png",
      "trust_level": 1,
      "post_number": 6,
      "post_type": 1,
      "like_count": null,
      "like_action": null,
      "Reads": 11,
      "wikis": null,
