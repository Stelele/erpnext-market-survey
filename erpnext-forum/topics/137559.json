    {
      "id": 446677,
      "username": "NCP",
      "name": "Nihantra Patel",
      "created_at": "2024-11-20T05:01:30.588Z",
      "cooked": "<aside class=\"quote no-group\" data-username=\"rogerbaron\" data-post=\"3\" data-topic=\"137559\">\n<div class=\"title\">\n<div class=\"quote-controls\"></div>\n<img loading=\"lazy\" alt=\"\" width=\"24\" height=\"24\" src=\"https://discuss.frappe.io/letter_avatar_proxy/v4/letter/r/dfb087/48.png\" class=\"avatar\"> rogerbaron:</div>\n<blockquote>\n<p>is it possible to remove the multi-select checkboxes</p>\n</blockquote>\n</aside>\n<p>Use it.</p>\n<aside class=\"quote no-group\" data-username=\"NCP\" data-post=\"2\" data-topic=\"137559\">\n<div class=\"title\">\n<div class=\"quote-controls\"></div>\n<img loading=\"lazy\" alt=\"\" width=\"24\" height=\"24\" src=\"https://discuss.frappe.io/user_avatar/discuss.frappe.io/ncp/48/66573_2.png\" class=\"avatar\"> NCP:</div>\n<blockquote>\n<pre><code class=\"lang-auto\">       frm.set_df_property('items', 'cannot_add_rows', true);\n       frm.set_df_property('items', 'cannot_delete_rows', true);\n       frm.set_df_property('items', 'cannot_delete_all_rows', true);\n</code></pre>\n</blockquote>\n</aside>\n<pre><code class=\"lang-auto\">$('.row-check').hide();\n</code></pre>",
