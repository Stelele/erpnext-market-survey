    {
      "id": 424022,
      "username": "MinHyeong-Lee",
      "name": "MinHyeong Lee",
      "created_at": "2024-07-24T01:43:20.483Z",
      "cooked": "<pre data-code-wrap=\"javascript\"><code class=\"lang-javascript\">function set_small_text_height() {\n    let field = \"size\";\n    let text_area = $(`textarea[data-fieldname=\"${field}\"]`);\n    let height = \"150px\"\n    text_area.css(\"height\", height);\n}\n\nfrappe.ui.form.on(\"Your Doctype\", {\n    refresh: function (frm) {\n        set_small_text_height();\n    }\n}\n</code></pre>\n<p>This way you can change the height of small text.</p>",
      "avatar_template": "/user_avatar/discuss.frappe.io/minhyeong-lee/{size}/63970_2.png",
      "trust_level": 2,
      "post_number": 4,
      "post_type": 1,
