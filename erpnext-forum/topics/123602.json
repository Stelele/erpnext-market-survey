    {
      "id": 461789,
      "username": "Striver-3110",
      "name": "jay-3110",
      "created_at": "2025-03-19T15:21:47.609Z",
      "cooked": "<p>Finally found solution!!!</p>\n<p><div class=\"lightbox-wrapper\"><a class=\"lightbox\" href=\"https://discuss.frappe.io/uploads/default/original/3X/e/1/e1aa3f340b46a04e07f522c455d5e351e2d831f8.png\" data-download-href=\"https://discuss.frappe.io/uploads/default/e1aa3f340b46a04e07f522c455d5e351e2d831f8\" title=\"image\"><img src=\"https://discuss.frappe.io/uploads/default/optimized/3X/e/1/e1aa3f340b46a04e07f522c455d5e351e2d831f8_2_690x138.png\" alt=\"image\" data-base62-sha1=\"wckblW4LdmMDgPLxwy3IcSPwhdu\" width=\"690\" height=\"138\" srcset=\"https://discuss.frappe.io/uploads/default/optimized/3X/e/1/e1aa3f340b46a04e07f522c455d5e351e2d831f8_2_690x138.png, https://discuss.frappe.io/uploads/default/original/3X/e/1/e1aa3f340b46a04e07f522c455d5e351e2d831f8.png 1.5x, https://discuss.frappe.io/uploads/default/original/3X/e/1/e1aa3f340b46a04e07f522c455d5e351e2d831f8.png 2x\" data-dominant-color=\"FAFAFA\"><div class=\"meta\"><svg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"><use href=\"#far-image\"></use></svg><span class=\"filename\">image</span><span class=\"informations\">981×197 14.8 KB</span><svg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"><use href=\"#discourse-expand\"></use></svg></div></a></div></p>\n<p>frappe.listview_settings[‘DocType’] = {<br>\nhide_name_column: true, // hide ID column<br>\nonload: function(listview) {<br>\nhideElements();<br>\n}<br>\n};</p>\n<p>function hideElements() {</p>\n<p>// hide status element<br>\ndocument.querySelectorAll(“.list-row-col.ellipsis.hidden-xs”).forEach((el) =&gt; {<br>\nif (el.innerText.trim() === “Status”) {<br>\nel.classList.add(“hide”);<br>\n}<br>\n});<br>\ndocument.querySelectorAll(“.list-row-col.hidden-xs.ellipsis”).forEach((el) =&gt; {<br>\nconst text = el.innerText.trim();<br>\nif ([“Draft”, “Submitted”, “Cancelled”].includes(text)) {<br>\nel.classList.add(“hide”);<br>\n}<br>\n});</p>\n<p>// hide like column<br>\ndocument.querySelectorAll(“.level-right”).forEach((el) =&gt; {<br>\nel.classList.add(“hide”);<br>\n});</p>\n<p>}</p>\n<p>// Monitor the DOM for changes and reapply the class when needed<br>\nconst observer = new MutationObserver(() =&gt; {<br>\nhideElements();<br>\n});</p>\n<p>observer.observe(document.body, {<br>\nchildList: true,<br>\nsubtree: true<br>\n});</p>\n<p>Thank me later!</p>",
