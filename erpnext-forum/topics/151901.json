    {
      "id": 477701,
      "username": "mohitchechani",
      "name": "Mohit Chechani",
      "created_at": "2025-08-16T11:38:51.177Z",
      "cooked": "<pre><code class=\"lang-auto\">bench --site {{site_name}} restore absolute_path_to_backup_file --with-public-files absolute_path_to_backup_of_public_files --with-private-files absolute_path_to_backup_of_private_files</code></pre>",
