      "id": 477675,
      "username": "Omar-Abdullah",
      "name": "Omar Shaikh Al Zoor",
      "created_at": "2025-08-16T08:34:00.348Z",
      "cooked": "<p>Use this command (backup file in format .sql.gz if using Mariadb Database):<br>\nsudo bench --site <em>site_name</em> --force restore <em>absolute_path_to_backup_file</em></p>\n<p><strong>example (in this example the backup is located inside the frappe-bench directory):</strong><br>\nsudo bench --site erp.local --force restore /home/frappe/frappe-bench/20250815_140038-erp.local-database.sql.gz</p>",
      "avatar_template": "/letter_avatar_proxy/v4/letter/o/df788c/{size}.png",
      "trust_level": 2,
      "post_number": 2,
      "post_type": 1,
      "like_count": null,
      "like_action": null,
      "Reads": 51,
      "wikis": null,
      "can_edit": false,
      "can_delete": false,
      "can_recover": false,
