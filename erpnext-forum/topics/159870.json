      "id": 492586,
      "username": "peterg",
      "name": "Peter",
      "created_at": "2026-01-27T02:14:43.680Z",
      "cooked": "<p>Nope. This is deliberate. Frappe development is much less centrally directed than in many other projects. As I have understood it, architectural changes are discussed and implemented by the maintainers internally, but feature development tends to happen whenever somebody with the ability or resources feels motivated to make them happen.</p>",
      "avatar_template": "/user_avatar/discuss.frappe.io/peterg/{size}/55463_2.png",
      "trust_level": 2,
      "post_number": 2,
      "post_type": 1,
