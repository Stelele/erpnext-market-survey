      "username": "meera-kardani",
      "name": "Meera Kardani",
      "created_at": "2024-09-06T09:59:16.688Z",
      "cooked": "<p>frappe.listview_settings[“Sales Person”] = {<br>\nhide_name_column: true,<br>\nadd_fields: [“supplier_cf”, “custom_user_id”],</p>\n<p>onload: function (me) {<br>\nme.page.set_title(__(“Sales Person List”));<br>\n},</p>\n<p>button: {<br>\nshow: function (doc) {<br>\nreturn !!doc.supplier_cf;<br>\n},<br>\nget_label: function () {<br>\nreturn __(“View Payout”);<br>\n},<br>\nget_description: function (doc) {<br>\nreturn __(“View Purchase Invoices for Supplier {0}”, [doc.supplier_cf]);<br>\n},<br>\naction: function (doc) {<br>\nfrappe.set_route(“List”, “Purchase Invoice”, {<br>\nsupplier: doc.supplier_cf,<br>\n});<br>\n},<br>\n},</p>\n<p>button: {<br>\nshow: function (doc) {<br>\nreturn !!doc.custom_user_id;<br>\n},<br>\nget_label: function () {<br>\nreturn __(“User”);<br>\n},<br>\nget_description: function (doc) {<br>\nreturn __(“View User for Supplier {0}”, [doc.custom_user_id]);<br>\n},<br>\naction: function (doc) {<br>\nfrappe.set_route(“Form”, “User”, doc.custom_user_id);<br>\n},<br>\n},<br>\n};</p>\n<p>this is my code</p>",
