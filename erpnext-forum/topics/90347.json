      "id": 326703,
      "username": "glz",
      "name": "Muchai",
      "created_at": "2022-05-30T09:41:01.501Z",
      "cooked": "<p>We used the client script below.</p>\n<pre><code class=\"lang-auto\">frappe.ui.form.on('Sales Invoice', {\n    on_submit: function (frm) {\n        send_sms(frm);\n    }\n});\n\n//Send SMS\nvar send_sms = function (frm) {\n    if (frm.doc.is_return === 0) {\n        if (frm.doc.send_sms === 1 &amp;&amp; frm.doc.mobile_contact_no) {\n            var message = 'Dear, ' + frm.doc.customer + ', Invoice: ' + frm.doc.name + ', Grand Total: ' + formatter.format(frm.doc.grand_total) + ', created at: ' + frm.doc.company;\n            frappe.call({\n                method: \"frappe.core.doctype.sms_settings.sms_settings.send_sms\",\n                args: {\n                    receiver_list: [frm.doc.mobile_contact_no],\n                    msg: message,\n                },\n                callback: function (r) {\n                    if (r.exc) {\n                        msgprint(r.exc);\n                        return;\n                    }\n                }\n            });\n        }\n    }\n}\n\n// Create our number formatter.\nvar formatter = new Intl.NumberFormat('en-US', {\n    style: 'currency',\n    currency: 'Ksh',\n});\n</code></pre>",
