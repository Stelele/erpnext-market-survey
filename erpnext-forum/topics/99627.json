    {
      "id": 351457,
      "username": "NCP",
      "name": "Nihantra Patel",
      "created_at": "2023-01-10T06:00:11.626Z",
      "cooked": "<p>Hi <a class=\"mention\" href=\"/u/vinoth\">@VINOTH</a>,</p>\n<p>Please try it.</p>\n<pre><code class=\"lang-auto\">frappe.ui.form.on('Child Table Name', {\n    duplicate_field_name: function(frm, cdt, cdn) {\n        var d = locals[cdt][cdn];\n        $.each(frm.doc.table_name, function(i, row) {\n            if (row.duplicate_field_name === d.duplicate_field_name &amp;&amp; row.name != d.name) {\n               frappe.msgprint('You added already exists on the table.');\n               frappe.model.remove_from_locals(cdt, cdn);\n               frm.refresh_field('table_name');\n               return false;\n            }\n        });\n    }\n});\n</code></pre>\n<p>Thank You!</p>",
