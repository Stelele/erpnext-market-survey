      "created_at": "2025-08-11T09:09:51.479Z",
      "cooked": "<p>We need to select the item using checkbox and click on create button so it will create the quality inspection for selected item only</p>",
      "avatar_template": "/user_avatar/discuss.frappe.io/nikitadattapawar06/{size}/84010_2.png",
      "trust_level": 1,
