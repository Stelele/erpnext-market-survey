      "id": 494738,
      "username": "mihir-kandoi",
      "name": "Mihir Kandoi",
      "created_at": "2026-02-20T14:47:19.352Z",
      "cooked": "<p>It was added 10 years ago <a href=\"https://github.com/frappe/erpnext/pull/3459\">here</a>.</p>\n<p>Logically speaking, you can’t actually log the purchase invoice until the supplier has given you a bill for it, right?</p>",
      "avatar_template": "/user_avatar/discuss.frappe.io/mihir-kandoi/{size}/92808_2.png",
      "trust_level": 2,
      "post_number": 2,
      "post_type": 1,
      "like_count": null,
      "like_action": null,
      "Reads": 23,
      "wikis": null,
