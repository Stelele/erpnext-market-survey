      "created_at": "2025-12-11T07:37:53.465Z",
      "cooked": "<p>frappe.query_reports[“Delivery Pending Report”] = {</p>\n<p>“filters”: [</p>\n<pre><code>    {\n</code></pre>\n<p>“fieldname”: “from_date”,</p>\n<p>“label”: __(“From Date”),</p>\n<p>“fieldtype”: “Date”,</p>\n<p>“default”: “frappe.datetime.add_months(frappe.datetime.get_today(), -3)”</p>\n<pre><code>    },\n\n    {\n</code></pre>\n<p>“fieldname”: “to_date”,</p>\n<p>“label”: __(“To Date”),</p>\n<p>“fieldtype”: “Date”,</p>\n<p>“default”: “frappe.datetime.get_today()”</p>\n<pre><code>    },\n\n    {\n</code></pre>\n<p>“fieldname”: “sales_partner”,</p>\n<p>“label”: __(“Agent”),</p>\n<p>“fieldtype”: “Link”,</p>\n<p>“options”: “Sales Partner”</p>\n<pre><code>    },\n\n    {\n</code></pre>\n<p>“fieldname”: “customer”,</p>\n<p>“label”: __(“Customer”),</p>\n<p>“fieldtype”: “Link”,</p>\n<p>“options”: “Customer”</p>\n<pre><code>    }\n\n\\],\n</code></pre>\n<p>};</p>",
