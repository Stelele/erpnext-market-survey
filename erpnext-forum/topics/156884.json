      "id": 486565,
      "username": "Pararera",
      "name": "Pararera",
      "created_at": "2025-11-15T18:27:49.454Z",
      "cooked": "<p>Hi,</p>\n<p>is there any way to restrict some users to see only documents which has field X set to value Y?<br>\nI have custom doctype and I want to restrict few users to see only docs.</p>",
      "avatar_template": "/user_avatar/discuss.frappe.io/pararera/{size}/33348_2.png",
      "trust_level": 2,
      "post_number": 1,
      "post_type": 1,
