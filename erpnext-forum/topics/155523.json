    {
      "id": 484006,
      "username": "revant_one",
      "name": "Revant Nandgaonkar",
      "created_at": "2025-10-15T05:02:11.078Z",
      "cooked": "<p>This is called every 10 minutes</p>\n<aside class=\"onebox githubblob\" data-onebox-src=\"https://github.com/frappe/frappe/blob/8b65540b6a4ae9d96012dd068b5b530fcf1ce7d4/frappe/hooks.py#L214-L217\">\n  <header class=\"source\">\n\n      <a href=\"https://github.com/frappe/frappe/blob/8b65540b6a4ae9d96012dd068b5b530fcf1ce7d4/frappe/hooks.py#L214-L217\" target=\"_blank\" rel=\"noopener\">github.com/frappe/frappe</a>\n  </header>\n\n  <article class=\"onebox-body\">\n    <h4><a href=\"https://github.com/frappe/frappe/blob/8b65540b6a4ae9d96012dd068b5b530fcf1ce7d4/frappe/hooks.py#L214-L217\" target=\"_blank\" rel=\"noopener\">frappe/hooks.py</a></h4>\n\n<div class=\"git-blob-info\">\n  <a href=\"https://github.com/frappe/frappe/blob/8b65540b6a4ae9d96012dd068b5b530fcf1ce7d4/frappe/hooks.py#L214-L217\" rel=\"noopener\"><code>8b65540b6</code></a>\n</div>\n\n\n\n    <pre class=\"onebox\"><code class=\"lang-py\">\n      <ol class=\"start lines\" start=\"214\" style=\"counter-reset: li-counter 213 ;\">\n          <li>\t\t# 10 minutes</li>\n          <li>\t\t\"0/10 * * * *\": [</li>\n          <li>\t\t\t\"frappe.email.doctype.email_account.email_account.pull\",</li>\n          <li>\t\t],</li>\n      </ol>\n    </code></pre>\n\n\n\n  </article>\n\n  <div class=\"onebox-metadata\">\n    \n    \n  </div>\n\n  <div style=\"clear: both\"></div>\n</aside>\n",
      "avatar_template": "/user_avatar/discuss.frappe.io/revant_one/{size}/55081_2.png",
